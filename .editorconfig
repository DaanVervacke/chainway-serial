# EditorConfig, editor-agnostic whitespace baseline. https://editorconfig.org
#
# This is the floor under the formatting stack: it makes every editor agree on
# charset, line endings, final newlines, and indentation before ruff runs.
# Python and TOML use 4 spaces, YAML uses 2 spaces.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.toml]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
